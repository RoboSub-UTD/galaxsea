<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wamv_with_zed2">
    <include>
      <!-- Bring in the base WAM-V from VRX -->
      <uri>model://wamv</uri>
    </include>

    <include>
      <!-- Bring in your ZED2 camera from your own package -->
      <uri>model://zed2_camera</uri>
      <pose>0.3 0 1.2 0 0 0</pose>
    </include>

    <!-- Fixed joint to attach ZED2 to WAM-V -->
    <joint name="wamv_zed2_fixed_joint" type="fixed">
      <parent>wamv::base_link</parent>
      <child>zed2_camera::zed2_link</child>
    </joint>
  </model>
</sdf>
